# Copy this file to ".env" for local notes, OR set these as environment variables
# before running the app. NEVER commit real secrets — ".env" is gitignored.
#
# Local development uses the Neon "dev" branch; Railway uses the Neon "main" branch.

# --- Database (Neon PostgreSQL) ---
# Use the JDBC form for Spring. Example from a Neon connection string:
#   postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
# becomes:
#   jdbc:postgresql://HOST/DBNAME?sslmode=require
DATABASE_URL=jdbc:postgresql://YOUR-NEON-HOST/neondb?sslmode=require
DB_USERNAME=your_neon_user
DB_PASSWORD=your_neon_password

# --- JWT (used from Phase 2) ---
# Use a long random string (32+ chars). Generate one, e.g. PowerShell:
#   [Convert]::ToBase64String((1..48 | % {Get-Random -Max 256}))
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRATION_MS=86400000

# --- Initial admin (seeded on first startup when users table is empty) ---
APP_ADMIN_EMAIL=ankitnehul2301@gmail.com
APP_ADMIN_PASSWORD=change-this-password

# --- CORS (set in Phase 5 to your Vercel domain) ---
# Comma-separated list, e.g. https://your-site.vercel.app,https://yourdomain.org
CORS_ALLOWED_ORIGINS=

# --- Profile ---
# Local: dev   |   Railway: prod
SPRING_PROFILES_ACTIVE=dev
